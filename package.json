{
  "name": "caret",
  "version": "1.0.0",
  "description": "A modern, lightweight code editor",
  "main": "main.js",
  "scripts": {
    "start": "set ELECTRON_RUN_AS_NODE=& electron .",
    "make-icon": "node scripts/make-icon.js",
    "dist": "electron-builder --win --dir",
    "dist-zip": "powershell -Command \"if(Test-Path installer/resources/app.zip){Remove-Item installer/resources/app.zip}; Compress-Archive -Path dist/win-unpacked/* -DestinationPath installer/resources/app.zip\""
  },
  "keywords": [
    "editor",
    "notepad",
    "code"
  ],
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.caret.editor",
    "productName": "Caret",
    "icon": "assets/icon.ico",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [{ "target": "dir", "arch": ["x64"] }]
    }
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.13.3",
    "jimp": "^0.22.12",
    "playwright-core": "^1.60.0",
    "to-ico": "^1.1.5"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^5.65.16",
    "node-pty": "^1.1.0"
  }
}
