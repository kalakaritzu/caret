{
  "name": "caret-setup",
  "version": "1.0.0",
  "description": "Caret installer",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.caret.installer",
    "productName": "Caret Setup",
    "icon": "../assets/icon.ico",
    "win": {
      "target": [{ "target": "dir", "arch": ["x64"] }]
    },
    "extraResources": [
      { "from": "resources/app.zip", "to": "app.zip" }
    ],
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^28.1.0",
    "electron-builder": "^24.13.3"
  }
}
